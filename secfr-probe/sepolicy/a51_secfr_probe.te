# SELinux domain for a51-secfr-probe.
#
# NOT WIRED INTO THE BUILD. This directory is not on BOARD_VENDOR_SEPOLICY_DIRS,
# so none of this reaches the policy until someone decides it should. To enable
# it, add to device/samsung/a51/BoardConfig.mk:
#
#     BOARD_VENDOR_SEPOLICY_DIRS += $(DEVICE_PATH)/secfr-probe/sepolicy
#
# and make the binary installable (see secfr-probe/Android.bp) so file_contexts
# has something to label.
#
# Why a domain of its own rather than reusing hal_face_default: the probe is not
# the face HAL, does not implement its interface and must not inherit its camera
# and binder access. What it needs is the trusted-application path and nothing
# else, and a separate domain is the only way to say exactly that. Making the
# device permissive would say the opposite.

type a51_secfr_probe, domain;
type a51_secfr_probe_exec, exec_type, vendor_file_type, file_type;

userdebug_or_eng(`
    # An operator runs this from a shell, so the transition is from shell rather
    # than from init.
    domain_auto_trans(shell, a51_secfr_probe_exec, a51_secfr_probe)
    allow a51_secfr_probe shell:fd use;
    allow a51_secfr_probe devpts:chr_file rw_file_perms;

    # The whole point: /dev/tzdev and the secure-OS property the client reads.
    # This is the same access the face, fingerprint, gatekeeper and keymaster
    # HALs already have on this device.
    teegris_use(a51_secfr_probe)
')

# No property rule is needed for the capture-model lookup: it reads ro.soc.model,
# which is soc_prop, and every domain already has get_prop on that.

# Deliberately absent, and each absence is a result the probe can report:
#
#   secmem_device       - only the secure frame path needs /dev/s5p-smem, and
#                         the probe never submits a frame.
#   fwk_camera_service  - no capture, so no camera server.
#   hal_graphics_allocator, hidl_token_hwservice, vndbinder
#                       - no buffers are allocated or handed to anyone.
#
# If the probe turns out to need any of them, the seam it was built to
# demonstrate is not where we think it is.

# HamelinPortsImsService (system_app) binds the Samsung vendor binder
# `vendor.samsung.hardware.radio.channel.ISehRadioChannel/imsd{,2}`
# (declared in vendor_service_contexts under type hal_radio_service)
# to notify the modem of IMS registration state. Without this route
# the modem doesn't learn that IMS is up and the EPC routes MT voice
# via CSFB instead of as an IMS INVITE.
#
# The forward binder_call(system_app, rild) and reverse
# allow(rild, system_app:binder call) are granted in
# sepolicy/vendor/rild.te; here we just need the service-manager find.
allow system_app hal_radio_service:service_manager find;

# Vendored c-ares (external/resiprocate/rutil/dns/ares/ares_init.c) probes
# net.dns1/net.dns2 via __system_property_find on its __ANDROID__ codepath.
# AOSP forbids system_app → net_dns_prop (domain.te neverallow): apps must
# go through ConnectivityManager.getLinkProperties().getDnsServers(). The
# read failing is harmless — c-ares falls through to a localhost stub and
# our SIP path doesn't need it (P-CSCF arrives via PCO). Silence the noise
# until c-ares is patched out of that codepath.
dontaudit system_app net_dns_prop:file read;

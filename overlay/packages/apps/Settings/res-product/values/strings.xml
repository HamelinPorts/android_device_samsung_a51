<?xml version="1.0" encoding="utf-8"?>
<!--
     Face enrolment body copy for the strings upstream declares in res-product.
     Soong globs overlays per resource dir, so these must sit under a res-product
     overlay dir to reach the base values at all. Only the "default" product is
     built: TARGET_AAPT_CHARACTERISTICS defaults to "default", so Soong passes no
     product flag to aapt2 and the other variants are filtered out.
-->
<resources>
    <!-- Introduction screen: what the user has to do while enrolling. -->
    <string name="security_settings_face_enroll_introduction_info_looking" product="default">Look directly at the screen when unlocking.</string>
    <string name="security_settings_face_enroll_introduction_info_gaze" product="default">Your eyes need to be open.</string>

    <!-- Introduction screen: security caveat shown next to the info icon. -->
    <string name="security_settings_face_enroll_introduction_info_less_secure" product="default">Face Unlock is less secure than a strong PIN or password. Someone who looks similar to you may be able to unlock your phone.</string>

    <!-- Introduction screen: section bodies. -->
    <string name="security_settings_face_enroll_introduction_how_message" product="default">Face Unlock creates a model of your face to recognise you. It\'s stored on your phone and never leaves it.</string>
    <string name="security_settings_face_enroll_introduction_control_message" product="default">You can delete your face model at any time in Settings, or turn off Face Unlock and use your PIN instead.</string>
</resources>
